{
  "name": "pwa-framework-frontend",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build --outDir .dist-build && node scripts/publish-build.mjs && node scripts/check-pwa.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "test": "vitest run --config vitest.config.js",
    "check:pwa": "node scripts/check-pwa.mjs",
    "test:e2e": "playwright test --project=chromium-desktop --project=chromium-mobile --project=firefox-desktop --project=webkit-desktop",
    "test:visual": "node scripts/visual-check.mjs",
    "lint": "eslint . && stylelint \"src/css/*.css\"",
    "check": "npm run lint && npm test && npm run build",
    "test:visual:prepare": "node scripts/visual-check.mjs --prepare"
  },
  "dependencies": {
    "framework7": "9.2.0",
    "framework7-icons": "5.0.5",
    "framework7-vue": "9.2.0",
    "imask": "7.6.1",
    "just-validate": "4.3.0",
    "lucide": "1.72.0",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@vitejs/plugin-vue": "6.0.11",
    "eslint": "10.15.0",
    "eslint-plugin-vue": "10.12.1",
    "globals": "16.5.0",
    "stylelint": "16.26.1",
    "stylelint-config-standard": "38.0.0",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1",
    "workbox-window": "7.4.1"
  }
}
