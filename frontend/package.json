{
  "name": "pwa-framework-frontend",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build --outDir .dist-build && node scripts/publish-build.mjs && node scripts/check-pwa.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "test": "node --test tests/unit/*.test.mjs",
    "check:pwa": "node scripts/check-pwa.mjs"
  },
  "dependencies": {
    "framework7": "9.2.0",
    "framework7-icons": "5.0.5",
    "framework7-vue": "9.2.0",
    "imask": "7.6.1",
    "just-validate": "4.3.0",
    "lucide": "1.72.0",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.11",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1",
    "workbox-window": "7.4.1"
  }
}
