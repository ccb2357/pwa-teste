# Identidade: slug deve corresponder ao nome da pasta clonada
PROJECT_SLUG=pwa-teste
PROJECT_NAME="PWA Framework"
APP_ENV=local

# Caminhos relativos à raiz do projeto e infraestrutura compartilhada
INFRA_COMPOSE_PATH=../infra/docker-compose.yml
CONTAINER_PROJECTS_ROOT=/var/www
DOCKER_NETWORK=infra_network
PHP_SERVICE=php-fpm
NGINX_SERVICE=nginx
NGINX_INTERNAL_URL=http://nginx

# Acesso local e produção
LOCAL_DOMAIN=pwa-teste.localhost
DEV_PORT=5176
PREVIEW_PORT=5177
PRODUCTION_URL=

# MySQL: usar exatamente a conta existente informada
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=pwa_teste
DB_TEST_DATABASE=pwa_teste_test
DB_USERNAME=root
DB_PASSWORD=""

# Regionalização e sessão
APP_LOCALE=pt_BR
APP_TIMEZONE=UTC
DISPLAY_TIMEZONE=America/Sao_Paulo
SESSION_LIFETIME=120

# Identidade pública da PWA
PWA_SHORT_NAME="PWA Framework"
PWA_DESCRIPTION="Descrição do aplicativo"
PWA_THEME_COLOR="#007aff"
PWA_BACKGROUND_COLOR="#ffffff"

# Push (habilitar somente ao preparar VAPID; subject deve ser contato real)
PUSH_ENABLED=false
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Somente em APP_ENV=local; nunca habilitar em produção
PUSH_TEST_AUTH_ENABLED=false
