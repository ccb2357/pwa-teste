# Gerado pelo bootstrap a partir de ../.env.foundation. Não editar valores compartilhados aqui.
APP_NAME="PWA Framework"
APP_ENV=testing
APP_KEY=
APP_DEBUG=false
APP_URL=http://pwa-teste.localhost
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_TIMEZONE=UTC
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=pwa_teste_test
DB_USERNAME=root
DB_PASSWORD=
SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_COOKIE=pwa_teste_session
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=pwa-teste.localhost,localhost:5176,localhost:5177
CACHE_STORE=array
QUEUE_CONNECTION=sync
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
MAIL_MAILER=log
FOUNDATION_MAIN_DATABASE=pwa_teste
FOUNDATION_TEST_DATABASE=pwa_teste_test
FOUNDATION_ENV=local
