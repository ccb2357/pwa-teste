{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "pwa-framework/backend",
    "type": "project",
    "description": "Backend reutiliz\u00e1vel da funda\u00e7\u00e3o PWA Framework",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "12.70.0",
        "laravel/sanctum": "4.4.0",
        "laravel-notification-channels/webpush": "13.0.1"
    },
    "require-dev": {
        "fakerphp/faker": "1.24.1",
        "laravel/pint": "1.30.4",
        "mockery/mockery": "1.6.15",
        "nunomaduro/collision": "8.9.6",
        "phpunit/phpunit": "11.5.57"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "format:check": "@php vendor/bin/pint --test"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {},
        "platform": {
            "php": "8.2.35"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
